        <mxCell id="n513" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;fontSize=12;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#8C7A76;" value="&lt;b&gt;Relationships&lt;/b&gt;&lt;br&gt;• categories 1 : N products · categories 1 : N categories (parent_id: sub-categories)&lt;br&gt;• products 1 : 1 product_details&lt;br&gt;• products 1 : N product_specifications, product_images, product_reviews&lt;br&gt;• orders 1 : N product_reviews · customers 1 : N product_reviews&lt;br&gt;• UNIQUE (order_id, product_id): one review per bought item" vertex="1">
          <mxGeometry height="220" width="430" x="1540" y="420" as="geometry" />
        </mxCell>
        <mxCell id="n514" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;fontSize=12;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#8C7A76;" value="&lt;b&gt;How to read it&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;background:#D5E8D4&quot;&gt;&amp;nbsp;1 - green&amp;nbsp;&lt;/span&gt; starts here: needs no other table (create these first)&lt;br&gt;&lt;span style=&quot;background:#E1D5E7&quot;&gt;&amp;nbsp;2, 3 … - purple&amp;nbsp;&lt;/span&gt; uses other tables; the number = the order you create them&lt;br&gt;&lt;span style=&quot;background:#F5F5F5&quot;&gt;&amp;nbsp;grey&amp;nbsp;&lt;/span&gt; a table from another module (only its key columns)&lt;br&gt;&lt;span style=&quot;background:#E3EEFA&quot;&gt;&amp;nbsp;blue row&amp;nbsp;&lt;/span&gt; stored on purpose: a fact of that moment&lt;br&gt;&lt;b&gt;bold&lt;/b&gt; = PK (primary key) · &lt;i&gt;italic&lt;/i&gt; = FK (points to another table)&lt;br&gt;Line ends: &lt;b&gt;|&lt;/b&gt; one · &lt;b&gt;o&lt;/b&gt; optional (zero) · &lt;b&gt;crow’s foot&lt;/b&gt; many" vertex="1">
          <mxGeometry height="150" width="500" x="40" y="734" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
