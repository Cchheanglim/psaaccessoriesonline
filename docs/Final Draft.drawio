  <diagram name="Meng Huy_Customers &amp; Membership" id="53uSIa8Dz6yqwyQDumaD">
    <mxGraphModel dx="1386" dy="942" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1900" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n393" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;" value="&lt;b style=&quot;font-size:24px&quot;&gt;Customers, Membership &amp;amp; Promo codes&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;The tier is not stored: it is worked out from the customer’s delivered orders. Promo codes are typed at checkout; the order remembers which one it used.&lt;/span&gt;" vertex="1">
