        </mxCell>
        <mxCell id="n391" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;fontSize=12;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#8C7A76;" value="&lt;b&gt;Relationships&lt;/b&gt;&lt;br&gt;• roles 1 : N role_permissions N : 1 permissions → &lt;b&gt;many-to-many&lt;/b&gt; (composite primary key, so a role cannot get the same permission twice)&lt;br&gt;• roles 1 : N users&lt;br&gt;• users 1 : 1 customers (a customer &lt;b&gt;is a&lt;/b&gt; user: specialization; staff have no customer row)&lt;br&gt;&lt;b&gt;3NF&lt;/b&gt;: customers keeps no copies of the user’s name, email or password, and no stored points or totals." vertex="1">
          <mxGeometry height="150" width="870" x="40" y="330" as="geometry" />
        </mxCell>
        <mxCell id="n392" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;fontSize=12;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#8C7A76;" value="&lt;b&gt;How to read it&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;background:#D5E8D4&quot;&gt;&amp;nbsp;1 - green&amp;nbsp;&lt;/span&gt; starts here: needs no other table (create these first)&lt;br&gt;&lt;span style=&quot;background:#E1D5E7&quot;&gt;&amp;nbsp;2, 3 … - purple&amp;nbsp;&lt;/span&gt; uses other tables; the number = the order you create them&lt;br&gt;&lt;span style=&quot;background:#F5F5F5&quot;&gt;&amp;nbsp;grey&amp;nbsp;&lt;/span&gt; a table from another module (only its key columns)&lt;br&gt;&lt;span style=&quot;background:#E3EEFA&quot;&gt;&amp;nbsp;blue row&amp;nbsp;&lt;/span&gt; stored on purpose: a fact of that moment&lt;br&gt;&lt;b&gt;bold&lt;/b&gt; = PK (primary key) · &lt;i&gt;italic&lt;/i&gt; = FK (points to another table)&lt;br&gt;Line ends: &lt;b&gt;|&lt;/b&gt; one · &lt;b&gt;o&lt;/b&gt; optional (zero) · &lt;b&gt;crow’s foot&lt;/b&gt; many" vertex="1">
          <mxGeometry height="150" width="500" x="40" y="520" as="geometry" />
        </mxCell>
        <mxCell id="vc-v420t1bgioRokruWk-1" parent="1" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fontSize=13;fillColor=#E1D5E7;fontColor=#000000;strokeColor=#9673A6;" value="3 - customers" vertex="1">
          <mxGeometry height="102" width="370" x="2010" y="140" as="geometry" />
        </mxCell>
        <mxCell id="vc-v420t1bgioRokruWk-2" parent="vc-v420t1bgioRokruWk-1" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;" value="id : bigint (PK)" vertex="1">
          <mxGeometry height="24" width="370" y="30" as="geometry" />
        </mxCell>
        <mxCell id="vc-v420t1bgioRokruWk-3" parent="vc-v420t1bgioRokruWk-1" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=12;fontStyle=2;" value="user_id : bigint (FK → users, UNIQUE)" vertex="1">
          <mxGeometry height="24" width="370" y="54" as="geometry" />
        </mxCell>
        <mxCell id="vc-v420t1bgioRokruWk-12" parent="vc-v420t1bgioRokruWk-1" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=12;" value="created_at, updated_at" vertex="1">
