        <mxCell id="n654" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;fontSize=11;fontStyle=1;html=1;endArrow=ERzeroToMany;startArrow=ERmandOne;endFill=0;startFill=0;endSize=10;startSize=10;rounded=0;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n593" target="n630"><mxGeometry x="0" relative="1" as="geometry"><mxPoint y="-9" as="offset"/><Array as="points"><mxPoint x="474" y="642"/><mxPoint x="474" y="132"/><mxPoint x="974" y="132"/><mxPoint x="974" y="502"/></Array></mxGeometry></mxCell>
        <mxCell id="n655" value="1 : N verifies" style="edgeStyle=orthogonalEdgeStyle;fontSize=11;fontStyle=1;html=1;endArrow=ERzeroToMany;startArrow=ERzeroToOne;endFill=0;startFill=0;endSize=10;startSize=10;rounded=0;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n605" target="n634"><mxGeometry x="0" relative="1" as="geometry"><mxPoint y="-9" as="offset"/><Array as="points"><mxPoint x="494" y="976"/><mxPoint x="494" y="117"/><mxPoint x="994" y="117"/><mxPoint x="994" y="598"/></Array></mxGeometry></mxCell>
        <mxCell id="n656" value="" style="edgeStyle=orthogonalEdgeStyle;fontSize=11;fontStyle=1;html=1;endArrow=ERoneToMany;startArrow=ERmandOne;endFill=0;startFill=0;endSize=10;startSize=10;rounded=0;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n609" target="n639"><mxGeometry x="0.7" relative="1" as="geometry"><mxPoint y="-9" as="offset"/><Array as="points"><mxPoint x="1014" y="192"/><mxPoint x="1014" y="764"/></Array></mxGeometry></mxCell>
        <mxCell id="n657" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;fontSize=11;fontStyle=1;html=1;endArrow=ERzeroToMany;startArrow=ERmandOne;endFill=0;startFill=0;endSize=10;startSize=10;rounded=0;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n588" target="n640"><mxGeometry x="0" relative="1" as="geometry"><mxPoint y="-9" as="offset"/><Array as="points"><mxPoint x="514" y="476"/><mxPoint x="514" y="102"/><mxPoint x="1034" y="102"/><mxPoint x="1034" y="788"/></Array></mxGeometry></mxCell>
        <mxCell id="n658" value="1 : N changes" style="edgeStyle=orthogonalEdgeStyle;fontSize=11;fontStyle=1;html=1;endArrow=ERzeroToMany;startArrow=ERzeroToOne;endFill=0;startFill=0;endSize=10;startSize=10;rounded=0;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n605" target="n641"><mxGeometry x="0" relative="1" as="geometry"><mxPoint y="-9" as="offset"/><Array as="points"><mxPoint x="534" y="976"/><mxPoint x="534" y="87"/><mxPoint x="1054" y="87"/><mxPoint x="1054" y="812"/></Array></mxGeometry></mxCell>
        <mxCell id="n659" value="&lt;b&gt;Relationships&lt;/b&gt;&lt;br&gt;• customers 1 : N orders · customer_addresses 1 : N orders · promo_codes 1 : N orders (optional)&lt;br&gt;• orders 1 : N order_items N : 1 products → &lt;b&gt;many-to-many&lt;/b&gt;&lt;br&gt;• orders 1 : N payments (a rejected slip, then a new one) · payment_methods 1 : N payments&lt;br&gt;• orders 1 : N order_status_history · order_statuses 1 : N order_status_history&lt;br&gt;• users verify payments and change statuses&lt;br&gt;&lt;b&gt;Receipt&lt;/b&gt;: printed from these rows — no receipt table." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;fontSize=12;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#8C7A76;" vertex="1" parent="1"><mxGeometry x="1540" y="330" width="430" height="250" as="geometry"/></mxCell>
        <mxCell id="n660" value="&lt;b&gt;Blue columns are facts of that moment&lt;/b&gt;&lt;br&gt;unit_price_usd is the price agreed in this sale (after any product sale); delivery_fee and member_discount follow rules that change over time; amount_usd is what was paid. The promo discount is calculated from promo_code_id. They can’t be recalculated later, so storing them is not redundancy." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;fontSize=12;fontColor=#000000;fillColor=#E3EEFA;strokeColor=#2563A8;" vertex="1" parent="1"><mxGeometry x="1540" y="600" width="430" height="200" as="geometry"/></mxCell>
        <mxCell id="n661" value="&lt;b&gt;How to read it&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;background:#D5E8D4&quot;&gt;&amp;nbsp;1 - green&amp;nbsp;&lt;/span&gt; starts here: needs no other table (create these first)&lt;br&gt;&lt;span style=&quot;background:#E1D5E7&quot;&gt;&amp;nbsp;2, 3 … - purple&amp;nbsp;&lt;/span&gt; uses other tables; the number = the order you create them&lt;br&gt;&lt;span style=&quot;background:#F5F5F5&quot;&gt;&amp;nbsp;grey&amp;nbsp;&lt;/span&gt; a table from another module (only its key columns)&lt;br&gt;&lt;span style=&quot;background:#E3EEFA&quot;&gt;&amp;nbsp;blue row&amp;nbsp;&lt;/span&gt; stored on purpose: a fact of that moment&lt;br&gt;&lt;b&gt;bold&lt;/b&gt; = PK (primary key) · &lt;i&gt;italic&lt;/i&gt; = FK (points to another table)&lt;br&gt;Line ends: &lt;b&gt;|&lt;/b&gt; one · &lt;b&gt;o&lt;/b&gt; optional (zero) · &lt;b&gt;crow’s foot&lt;/b&gt; many" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;fontSize=12;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#8C7A76;" vertex="1" parent="1"><mxGeometry x="40" y="1076" width="500" height="150" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="nf-10" name="Messages">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1900" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="n662" value="&lt;b style=&quot;font-size:24px&quot;&gt;Messages (and the bell)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Each order has its own chat between the customer and staff. The notification bell has no table: it is built from orders, status changes, payment slips and messages.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1700" height="70" as="geometry"/></mxCell>
        <mxCell id="n663" value="users (User module)" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fontSize=13;fillColor=#F5F5F5;fontColor=#333333;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="370" height="102" as="geometry"/></mxCell>
        <mxCell id="n664" value="id : bigint (PK)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;" vertex="1" parent="n663"><mxGeometry y="30" width="370" height="24" as="geometry"/></mxCell>
        <mxCell id="n665" value="role_id : bigint (FK → roles)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=12;fontStyle=2;" vertex="1" parent="n663"><mxGeometry y="54" width="370" height="24" as="geometry"/></mxCell>
        <mxCell id="n666" value="name : varchar" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="n663"><mxGeometry y="78" width="370" height="24" as="geometry"/></mxCell>
        <mxCell id="n667" value="orders (Order module)" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fontSize=13;fillColor=#F5F5F5;fontColor=#333333;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="282" width="370" height="102" as="geometry"/></mxCell>
        <mxCell id="n668" value="id : bigint (PK)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;" vertex="1" parent="n667"><mxGeometry y="30" width="370" height="24" as="geometry"/></mxCell>
        <mxCell id="n669" value="order_number : varchar (UNIQUE)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="n667"><mxGeometry y="54" width="370" height="24" as="geometry"/></mxCell>
        <mxCell id="n670" value="customer_id : bigint (FK → customers)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=12;fontStyle=2;" vertex="1" parent="n667"><mxGeometry y="78" width="370" height="24" as="geometry"/></mxCell>
        <mxCell id="n671" value="6 - order_messages" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fontSize=13;fillColor=#E1D5E7;fontColor=#000000;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="540" y="140" width="370" height="174" as="geometry"/></mxCell>
        <mxCell id="n672" value="id : bigint (PK)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;" vertex="1" parent="n671"><mxGeometry y="30" width="370" height="24" as="geometry"/></mxCell>
        <mxCell id="n673" value="order_id : bigint (FK → orders)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=12;fontStyle=2;" vertex="1" parent="n671"><mxGeometry y="54" width="370" height="24" as="geometry"/></mxCell>
        <mxCell id="n674" value="sender_id : bigint (FK → users)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=12;fontStyle=2;" vertex="1" parent="n671"><mxGeometry y="78" width="370" height="24" as="geometry"/></mxCell>
        <mxCell id="n675" value="body : text" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="n671"><mxGeometry y="102" width="370" height="24" as="geometry"/></mxCell>
        <mxCell id="n676" value="read_at : timestamp" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="n671"><mxGeometry y="126" width="370" height="24" as="geometry"/></mxCell>
        <mxCell id="n677" value="created_at, updated_at" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="n671"><mxGeometry y="150" width="370" height="24" as="geometry"/></mxCell>
        <mxCell id="n678" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;fontSize=11;fontStyle=1;html=1;endArrow=ERzeroToMany;startArrow=ERmandOne;endFill=0;startFill=0;endSize=10;startSize=10;rounded=0;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n668" target="n673"><mxGeometry x="0.7" relative="1" as="geometry"><mxPoint y="-9" as="offset"/><Array as="points"><mxPoint x="434" y="324"/><mxPoint x="434" y="206"/></Array></mxGeometry></mxCell>
        <mxCell id="n679" value="1 : N sends" style="edgeStyle=orthogonalEdgeStyle;fontSize=11;fontStyle=1;html=1;endArrow=ERzeroToMany;startArrow=ERmandOne;endFill=0;startFill=0;endSize=10;startSize=10;rounded=0;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n664" target="n674"><mxGeometry x="0.7" relative="1" as="geometry"><mxPoint y="-9" as="offset"/><Array as="points"><mxPoint x="454" y="182"/><mxPoint x="454" y="230"/></Array></mxGeometry></mxCell>
        <mxCell id="n680" value="&lt;b&gt;Relationships&lt;/b&gt;&lt;br&gt;• orders 1 : N order_messages · users 1 : N order_messages (sender_id)&lt;br&gt;Whether a message is from staff = is the sender the order’s customer? So no from_staff column (3NF).&lt;br&gt;&lt;b&gt;The bell&lt;/b&gt;: new orders, status changes, slips sent back and messages of the last 30 days, worked out when the page asks. The browser remembers when the bell was last opened, so nothing is stored for it." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;fontSize=12;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#8C7A76;" vertex="1" parent="1"><mxGeometry x="1040" y="140" width="700" height="170" as="geometry"/></mxCell>
        <mxCell id="n681" value="&lt;b&gt;How to read it&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;background:#D5E8D4&quot;&gt;&amp;nbsp;1 - green&amp;nbsp;&lt;/span&gt; starts here: needs no other table (create these first)&lt;br&gt;&lt;span style=&quot;background:#E1D5E7&quot;&gt;&amp;nbsp;2, 3 … - purple&amp;nbsp;&lt;/span&gt; uses other tables; the number = the order you create them&lt;br&gt;&lt;span style=&quot;background:#F5F5F5&quot;&gt;&amp;nbsp;grey&amp;nbsp;&lt;/span&gt; a table from another module (only its key columns)&lt;br&gt;&lt;span style=&quot;background:#E3EEFA&quot;&gt;&amp;nbsp;blue row&amp;nbsp;&lt;/span&gt; stored on purpose: a fact of that moment&lt;br&gt;&lt;b&gt;bold&lt;/b&gt; = PK (primary key) · &lt;i&gt;italic&lt;/i&gt; = FK (points to another table)&lt;br&gt;Line ends: &lt;b&gt;|&lt;/b&gt; one · &lt;b&gt;o&lt;/b&gt; optional (zero) · &lt;b&gt;crow’s foot&lt;/b&gt; many" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;fontSize=12;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#8C7A76;" vertex="1" parent="1"><mxGeometry x="40" y="424" width="500" height="150" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="nf-11" name="Shop content">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1900" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="n682" value="&lt;b style=&quot;font-size:24px&quot;&gt;Shop content (staff-managed)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;The home showcase, the shop’s Sort By menu (with free-delivery groups) and shop-wide text such as the headline and social accounts.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1700" height="70" as="geometry"/></mxCell>
        <mxCell id="n683" value="products (Product module)" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fontSize=13;fillColor=#F5F5F5;fontColor=#333333;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="370" height="126" as="geometry"/></mxCell>
