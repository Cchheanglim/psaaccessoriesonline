        <mxCell id="n777" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=ERzeroToMany;startArrow=ERzeroToOne;endFill=0;startFill=0;endSize=9;startSize=9;fontSize=11;fontStyle=1;labelBackgroundColor=default;exitX=0;exitY=0.833;exitDx=0;exitDy=0;entryX=1;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="n717" target="n730"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1203" y="288"/><mxPoint x="1203" y="670"/><mxPoint x="308" y="670"/><mxPoint x="308" y="813"/></Array></mxGeometry></mxCell>
        <mxCell id="n778" value="&lt;b&gt;Many-to-many&lt;/b&gt;: roles ⟷ permissions (role_permissions), orders ⟷ products (order_items), purchase_orders ⟷ products (purchase_order_items), sort_options ⟷ products (sort_option_products). &lt;b&gt;One-to-one&lt;/b&gt;: users – customers, products – product_details. &lt;b&gt;Self-link&lt;/b&gt;: categories.parent_id. &lt;b&gt;Lookup&lt;/b&gt;: loyalty_tiers (no FK). Everything else is one-to-many." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;fontSize=12;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#8C7A76;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="1100" height="70" as="geometry"/></mxCell>
        <mxCell id="n779" value="&lt;b&gt;How to read it&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;background:#D5E8D4&quot;&gt;&amp;nbsp;1 - green&amp;nbsp;&lt;/span&gt; starts here: needs no other table (create these first)&lt;br&gt;&lt;span style=&quot;background:#E1D5E7&quot;&gt;&amp;nbsp;2, 3 … - purple&amp;nbsp;&lt;/span&gt; uses other tables; the number = the order you create them&lt;br&gt;&lt;span style=&quot;background:#F5F5F5&quot;&gt;&amp;nbsp;grey&amp;nbsp;&lt;/span&gt; a table from another module (only its key columns)&lt;br&gt;&lt;span style=&quot;background:#E3EEFA&quot;&gt;&amp;nbsp;blue row&amp;nbsp;&lt;/span&gt; stored on purpose: a fact of that moment&lt;br&gt;&lt;b&gt;bold&lt;/b&gt; = PK (primary key) · &lt;i&gt;italic&lt;/i&gt; = FK (points to another table)&lt;br&gt;Line ends: &lt;b&gt;|&lt;/b&gt; one · &lt;b&gt;o&lt;/b&gt; optional (zero) · &lt;b&gt;crow’s foot&lt;/b&gt; many" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;fontSize=12;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#8C7A76;" vertex="1" parent="1"><mxGeometry x="1260" y="96" width="500" height="150" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
