        <mxCell id="n441" value="1 : 1" style="edgeStyle=orthogonalEdgeStyle;fontSize=11;fontStyle=1;html=1;endArrow=ERzeroToOne;startArrow=ERmandOne;endFill=0;startFill=0;endSize=10;startSize=10;rounded=0;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n395" target="n407"><mxGeometry x="0.7" relative="1" as="geometry"><mxPoint y="-9" as="offset"/><Array as="points"><mxPoint x="434" y="192"/><mxPoint x="434" y="216"/></Array></mxGeometry></mxCell>
        <mxCell id="n442" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;fontSize=11;fontStyle=1;html=1;endArrow=ERzeroToMany;startArrow=ERmandOne;endFill=0;startFill=0;endSize=10;startSize=10;rounded=0;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n406" target="n424"><mxGeometry x="0.7" relative="1" as="geometry"><mxPoint y="-9" as="offset"/><Array as="points"><mxPoint x="934" y="192"/><mxPoint x="934" y="216"/></Array></mxGeometry></mxCell>
        <mxCell id="n443" value="1 : N places" style="edgeStyle=orthogonalEdgeStyle;fontSize=11;fontStyle=1;html=1;endArrow=ERzeroToMany;startArrow=ERmandOne;endFill=0;startFill=0;endSize=10;startSize=10;rounded=0;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n406" target="n437"><mxGeometry x="0" relative="1" as="geometry"><mxPoint y="-9" as="offset"/><Array as="points"><mxPoint x="954" y="192"/><mxPoint x="954" y="132"/><mxPoint x="1434" y="132"/><mxPoint x="1434" y="240"/></Array></mxGeometry></mxCell>
        <mxCell id="n444" value="1 : N ships to" style="edgeStyle=orthogonalEdgeStyle;fontSize=11;fontStyle=1;html=1;endArrow=ERzeroToMany;startArrow=ERmandOne;endFill=0;startFill=0;endSize=10;startSize=10;rounded=0;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n423" target="n438"><mxGeometry x="0.7" relative="1" as="geometry"><mxPoint y="-9" as="offset"/><Array as="points"><mxPoint x="1454" y="192"/><mxPoint x="1454" y="264"/></Array></mxGeometry></mxCell>
        <mxCell id="n445" value="1 : N uses" style="edgeStyle=orthogonalEdgeStyle;fontSize=11;fontStyle=1;html=1;endArrow=ERzeroToMany;startArrow=ERzeroToOne;endFill=0;startFill=0;endSize=10;startSize=10;rounded=0;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n410" target="n439"><mxGeometry x="0" relative="1" as="geometry"><mxPoint y="-9" as="offset"/><Array as="points"><mxPoint x="974" y="334"/><mxPoint x="974" y="117"/><mxPoint x="1474" y="117"/><mxPoint x="1474" y="288"/></Array></mxGeometry></mxCell>
        <mxCell id="n446" value="&lt;b&gt;How membership works&lt;/b&gt;&lt;br&gt;• Plus from $0 · Pro from $100 (6% off) · Max from $500 (17% off)&lt;br&gt;• Spending = delivered orders since the last gap of 18 days without an order&lt;br&gt;• Tier = the loyalty_tiers row with the highest min_spend_usd ≤ that spending&lt;br&gt;• At checkout the tier’s % comes off the items → orders.member_discount_usd (the tier changes later, so it is stored)&lt;br&gt;• A promo code then comes off what is left → calculated from promo_codes" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;fontSize=12;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#8C7A76;" vertex="1" parent="1"><mxGeometry x="1540" y="380" width="430" height="250" as="geometry"/></mxCell>
        <mxCell id="n447" value="&lt;b&gt;Addresses&lt;/b&gt;&lt;br&gt;An order points at the address it ships to. Once an address is used by an order it is never edited: “edit” saves a new address and sets &lt;i&gt;archived_at&lt;/i&gt; on the old one. The order’s address therefore never changes, with no copy on the order. One default per customer: UNIQUE (customer_id) WHERE is_default." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;fontSize=12;fontColor=#000000;fillColor=#E1F3E9;strokeColor=#1E7A4C;" vertex="1" parent="1"><mxGeometry x="1540" y="650" width="430" height="170" as="geometry"/></mxCell>
        <mxCell id="n448" value="&lt;b&gt;How to read it&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;background:#D5E8D4&quot;&gt;&amp;nbsp;1 - green&amp;nbsp;&lt;/span&gt; starts here: needs no other table (create these first)&lt;br&gt;&lt;span style=&quot;background:#E1D5E7&quot;&gt;&amp;nbsp;2, 3 … - purple&amp;nbsp;&lt;/span&gt; uses other tables; the number = the order you create them&lt;br&gt;&lt;span style=&quot;background:#F5F5F5&quot;&gt;&amp;nbsp;grey&amp;nbsp;&lt;/span&gt; a table from another module (only its key columns)&lt;br&gt;&lt;span style=&quot;background:#E3EEFA&quot;&gt;&amp;nbsp;blue row&amp;nbsp;&lt;/span&gt; stored on purpose: a fact of that moment&lt;br&gt;&lt;b&gt;bold&lt;/b&gt; = PK (primary key) · &lt;i&gt;italic&lt;/i&gt; = FK (points to another table)&lt;br&gt;Line ends: &lt;b&gt;|&lt;/b&gt; one · &lt;b&gt;o&lt;/b&gt; optional (zero) · &lt;b&gt;crow’s foot&lt;/b&gt; many" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;fontSize=12;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#8C7A76;" vertex="1" parent="1"><mxGeometry x="40" y="860" width="500" height="150" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="nf-7" name="Products &amp; Categories">
