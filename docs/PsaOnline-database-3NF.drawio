        <mxCell id="n514" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;fontSize=11;fontStyle=1;html=1;endArrow=ERzeroToMany;startArrow=ERzeroToOne;endFill=0;startFill=0;endSize=10;startSize=10;rounded=0;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n479" target="n505"><mxGeometry x="0" relative="1" as="geometry"><mxPoint y="-9" as="offset"/><Array as="points"><mxPoint x="1454" y="192"/><mxPoint x="1454" y="117"/><mxPoint x="1974" y="117"/><mxPoint x="1974" y="336"/></Array></mxGeometry></mxCell>
        <mxCell id="n515" value="" style="edgeStyle=orthogonalEdgeStyle;fontSize=11;fontStyle=1;html=1;endArrow=ERzeroToMany;startArrow=ERzeroToOne;endFill=0;startFill=0;endSize=10;startSize=10;rounded=0;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n492" target="n504"><mxGeometry x="0.7" relative="1" as="geometry"><mxPoint y="-9" as="offset"/><Array as="points"><mxPoint x="1994" y="382"/><mxPoint x="1994" y="312"/></Array></mxGeometry></mxCell>
        <mxCell id="n516" value="&lt;b&gt;How stock moves&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Buy&lt;/b&gt;: a purchase order is received → one movement per item (type = purchase, +qty, linked to the purchase_order_item that holds the cost)&lt;br&gt;• &lt;b&gt;Sell&lt;/b&gt;: an order is placed → one movement per item (type = sale, −qty, linked to the order_item that holds the price)&lt;br&gt;• &lt;b&gt;Adjust / damage&lt;/b&gt;: staff fix the count with a reason&lt;br&gt;• &lt;b&gt;Cancel / return&lt;/b&gt;: type = return, +qty&lt;br&gt;Stock on hand = SUM(quantity_change). Low stock when that ≤ products.low_stock_threshold.&lt;br&gt;Profit per item = (unit_price_usd − unit_cost_usd) × quantity." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;fontSize=12;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#8C7A76;" vertex="1" parent="1"><mxGeometry x="540" y="420" width="790" height="230" as="geometry"/></mxCell>
        <mxCell id="n517" value="&lt;b&gt;How to read it&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;background:#D5E8D4&quot;&gt;&amp;nbsp;1 - green&amp;nbsp;&lt;/span&gt; starts here: needs no other table (create these first)&lt;br&gt;&lt;span style=&quot;background:#E1D5E7&quot;&gt;&amp;nbsp;2, 3 … - purple&amp;nbsp;&lt;/span&gt; uses other tables; the number = the order you create them&lt;br&gt;&lt;span style=&quot;background:#F5F5F5&quot;&gt;&amp;nbsp;grey&amp;nbsp;&lt;/span&gt; a table from another module (only its key columns)&lt;br&gt;&lt;span style=&quot;background:#E3EEFA&quot;&gt;&amp;nbsp;blue row&amp;nbsp;&lt;/span&gt; stored on purpose: a fact of that moment&lt;br&gt;&lt;b&gt;bold&lt;/b&gt; = PK (primary key) · &lt;i&gt;italic&lt;/i&gt; = FK (points to another table)&lt;br&gt;Line ends: &lt;b&gt;|&lt;/b&gt; one · &lt;b&gt;o&lt;/b&gt; optional (zero) · &lt;b&gt;crow’s foot&lt;/b&gt; many" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;fontSize=12;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#8C7A76;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="500" height="150" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
