        <mxCell id="n589" value="1 : N changes" style="edgeStyle=orthogonalEdgeStyle;fontSize=11;fontStyle=1;html=1;endArrow=ERzeroToMany;startArrow=ERzeroToOne;endFill=0;startFill=0;endSize=10;startSize=10;rounded=0;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n520" target="n573"><mxGeometry x="0" relative="1" as="geometry"><mxPoint y="-9" as="offset"/><Array as="points"><mxPoint x="514" y="192"/><mxPoint x="514" y="102"/><mxPoint x="1034" y="102"/><mxPoint x="1034" y="812"/></Array></mxGeometry></mxCell>
        <mxCell id="n590" value="&lt;b&gt;Relationships&lt;/b&gt;&lt;br&gt;• users 1 : N orders · customer_addresses 1 : N orders · promo_codes 1 : N orders (optional)&lt;br&gt;• orders 1 : N order_items N : 1 products → &lt;b&gt;many-to-many&lt;/b&gt;&lt;br&gt;• orders 1 : N payments (a rejected slip, then a new one) · payment_methods 1 : N payments&lt;br&gt;• orders 1 : N order_status_history (status = the step’s code, checked by the database)&lt;br&gt;• users verify payments and change statuses&lt;br&gt;&lt;b&gt;Receipt&lt;/b&gt;: printed from these rows — no receipt table." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;fontSize=12;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#8C7A76;" vertex="1" parent="1"><mxGeometry x="1540" y="330" width="430" height="250" as="geometry"/></mxCell>
        <mxCell id="n591" value="&lt;b&gt;Blue columns are facts of that moment&lt;/b&gt;&lt;br&gt;unit_price_usd is the price agreed in this sale (after any product sale); delivery_fee and member_discount follow rules that change over time; amount_usd is what was paid. The promo discount is calculated from promo_code_id. They can’t be recalculated later, so storing them is not redundancy." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;fontSize=12;fontColor=#000000;fillColor=#E3EEFA;strokeColor=#2563A8;" vertex="1" parent="1"><mxGeometry x="1540" y="600" width="430" height="200" as="geometry"/></mxCell>
        <mxCell id="n592" value="&lt;b&gt;How to read it&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;background:#D5E8D4&quot;&gt;&amp;nbsp;1 - green&amp;nbsp;&lt;/span&gt; starts here: needs no other table (create these first)&lt;br&gt;&lt;span style=&quot;background:#E1D5E7&quot;&gt;&amp;nbsp;2, 3 … - purple&amp;nbsp;&lt;/span&gt; uses other tables; the number = the order you create them&lt;br&gt;&lt;span style=&quot;background:#F5F5F5&quot;&gt;&amp;nbsp;grey&amp;nbsp;&lt;/span&gt; a table from another module (only its key columns)&lt;br&gt;&lt;span style=&quot;background:#E3EEFA&quot;&gt;&amp;nbsp;blue row&amp;nbsp;&lt;/span&gt; stored on purpose: a fact of that moment&lt;br&gt;&lt;b&gt;bold&lt;/b&gt; = PK (primary key) · &lt;i&gt;italic&lt;/i&gt; = FK (points to another table)&lt;br&gt;Line ends: &lt;b&gt;|&lt;/b&gt; one · &lt;b&gt;o&lt;/b&gt; optional (zero) · &lt;b&gt;crow’s foot&lt;/b&gt; many" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;fontSize=12;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#8C7A76;" vertex="1" parent="1"><mxGeometry x="40" y="912" width="500" height="150" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="nf-10" name="Messages">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1900" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="n593" value="&lt;b style=&quot;font-size:24px&quot;&gt;Messages (and the bell)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Each order has its own chat between the customer and staff. The notification bell has no table: it is built from orders, status changes, payment slips and messages.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1700" height="70" as="geometry"/></mxCell>
        <mxCell id="n594" value="users (User module)" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fontSize=13;fillColor=#F5F5F5;fontColor=#333333;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="370" height="102" as="geometry"/></mxCell>
        <mxCell id="n595" value="id : bigint (PK)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;" vertex="1" parent="n594"><mxGeometry y="30" width="370" height="24" as="geometry"/></mxCell>
