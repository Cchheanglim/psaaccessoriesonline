        <mxCell id="n455" value="&lt;b style=&quot;font-size:24px&quot;&gt;Stock &amp;amp; Suppliers (buy price / sell price)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;What you BUY comes in through purchase orders; what you SELL goes out through order items. Every stock change is a row in stock_movements; stock on hand is their sum.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1700" height="70" as="geometry"/></mxCell>
