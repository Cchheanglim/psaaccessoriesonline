        <mxCell id="n518" value="&lt;b style=&quot;font-size:24px&quot;&gt;Orders, Delivery &amp;amp; Payment&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Checkout creates the order, its items, its first payment row and its first status. The order points at its address; totals, status and method are calculated.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1700" height="70" as="geometry"/></mxCell>
