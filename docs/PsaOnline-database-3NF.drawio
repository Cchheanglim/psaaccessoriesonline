        <mxCell id="n449" value="&lt;b style=&quot;font-size:24px&quot;&gt;Products &amp;amp; Categories&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;The catalog. Specifications are one row per fact (1NF). Stock is not stored here: it is the sum of stock movements.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1700" height="70" as="geometry"/></mxCell>
