        <mxCell id="n707" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:12px&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:250px;&quot;&gt;header.announcement_1&lt;/td&gt;&lt;td style=&quot;width:330px;&quot;&gt;Free delivery in Phnom Penh on orders $15+&lt;/td&gt;&lt;td style=&quot;text-align:center;&quot;&gt;&lt;span style=&quot;background:#E1F3E9;padding:1px 5px;border-radius:4px&quot;&gt;H&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;overflow=hidden;html=1;fontSize=12;" vertex="1" parent="n702"><mxGeometry y="126" width="640" height="24" as="geometry"/></mxCell>
