        <mxCell id="n321" value="&lt;b&gt;Where each module’s data lives&lt;/b&gt;: Account → users, customers, customer_addresses · Shop &amp;amp; Cart → products, categories, product_images, product_specifications, sort_options (cart stays in the browser) · Checkout → orders, order_items, payments · Tracking &amp;amp; Receipt → order_status_history · Reviews → product_reviews · Membership → loyalty_tiers (tier calculated from orders) · Promo codes → promo_codes · Chat → order_messages (the bell is calculated)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;fontSize=12;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#8C7A76;" vertex="1" parent="1"><mxGeometry x="20" y="550" width="940" height="90" as="geometry"/></mxCell>
        <mxCell id="n322" value="&lt;b&gt;Staff side&lt;/b&gt;: Users → users, roles, permissions, role_permissions · Products → products, product_details, product_specifications, product_images · Stock → suppliers, purchase_orders, purchase_order_items, stock_movements · Orders → orders, order_items, payments, order_status_history · Promo codes → promo_codes · Shop content → products.showcase_position, sort_options, sort_option_products, site_settings · Reports → calculated (no report tables)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;fontSize=12;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#8C7A76;" vertex="1" parent="1"><mxGeometry x="980" y="550" width="940" height="90" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="nf-5" name="Users &amp; Roles">
