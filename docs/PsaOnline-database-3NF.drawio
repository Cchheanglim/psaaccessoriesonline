        <mxCell id="n268" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;fontSize=10;fontStyle=1;html=1;endArrow=ERzeroToMany;startArrow=ERzeroToOne;endFill=0;startFill=0;endSize=9;startSize=9;rounded=0;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n107" target="n232"><mxGeometry x="0.75" relative="1" as="geometry"><mxPoint y="-8" as="offset"/><Array as="points"><mxPoint x="1087" y="1010"/><mxPoint x="1087" y="294"/><mxPoint x="3143" y="294"/><mxPoint x="3143" y="558"/></Array></mxGeometry></mxCell>
        <mxCell id="n269" value="1 : N verifies" style="edgeStyle=orthogonalEdgeStyle;fontSize=10;fontStyle=1;html=1;endArrow=ERzeroToMany;startArrow=ERzeroToOne;endFill=0;startFill=0;endSize=9;startSize=9;rounded=0;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n107" target="n217"><mxGeometry x="0.75" relative="1" as="geometry"><mxPoint y="-8" as="offset"/><Array as="points"><mxPoint x="1100" y="1010"/><mxPoint x="1100" y="307"/><mxPoint x="2629" y="307"/><mxPoint x="2629" y="1344"/></Array></mxGeometry></mxCell>
        <mxCell id="n270" value="1 : N changes" style="edgeStyle=orthogonalEdgeStyle;fontSize=10;fontStyle=1;html=1;endArrow=ERzeroToMany;startArrow=ERzeroToOne;endFill=0;startFill=0;endSize=9;startSize=9;rounded=0;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n107" target="n207"><mxGeometry x="0.75" relative="1" as="geometry"><mxPoint y="-8" as="offset"/><Array as="points"><mxPoint x="1113" y="1010"/><mxPoint x="1113" y="320"/><mxPoint x="2642" y="320"/><mxPoint x="2642" y="1058"/></Array></mxGeometry></mxCell>
        <mxCell id="n271" value="1 : N sends" style="edgeStyle=orthogonalEdgeStyle;fontSize=10;fontStyle=1;html=1;endArrow=ERzeroToMany;startArrow=ERmandOne;endFill=0;startFill=0;endSize=9;startSize=9;rounded=0;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n107" target="n190"><mxGeometry x="0.75" relative="1" as="geometry"><mxPoint y="-8" as="offset"/><Array as="points"><mxPoint x="1126" y="1010"/><mxPoint x="1126" y="333"/><mxPoint x="2655" y="333"/><mxPoint x="2655" y="558"/></Array></mxGeometry></mxCell>
        <mxCell id="n272" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;fontSize=10;fontStyle=1;html=1;endArrow=ERzeroToMany;startArrow=ERzeroToOne;endFill=0;startFill=0;endSize=9;startSize=9;rounded=0;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n107" target="n144"><mxGeometry x="0.75" relative="1" as="geometry"><mxPoint y="-8" as="offset"/><Array as="points"><mxPoint x="1139" y="1010"/><mxPoint x="1139" y="1294"/></Array></mxGeometry></mxCell>
        <mxCell id="n273" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;fontSize=10;fontStyle=1;html=1;endArrow=ERzeroToMany;startArrow=ERmandOne;endFill=0;startFill=0;endSize=9;startSize=9;rounded=0;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n36" target="n206"><mxGeometry x="0.75" relative="1" as="geometry"><mxPoint y="-8" as="offset"/><Array as="points"><mxPoint x="443" y="1058"/><mxPoint x="443" y="346"/><mxPoint x="2668" y="346"/><mxPoint x="2668" y="1034"/></Array></mxGeometry></mxCell>
        <mxCell id="n274" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;fontSize=10;fontStyle=1;html=1;endArrow=ERzeroToMany;startArrow=ERmandOne;endFill=0;startFill=0;endSize=9;startSize=9;rounded=0;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n41" target="n213"><mxGeometry x="0.75" relative="1" as="geometry"><mxPoint y="-8" as="offset"/><Array as="points"><mxPoint x="456" y="1224"/><mxPoint x="456" y="359"/><mxPoint x="2681" y="359"/><mxPoint x="2681" y="1248"/></Array></mxGeometry></mxCell>
        <mxCell id="n275" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;fontSize=10;fontStyle=1;html=1;endArrow=ERoneToMany;startArrow=ERmandOne;endFill=0;startFill=0;endSize=9;startSize=9;rounded=0;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n150" target="n172"><mxGeometry x="0.75" relative="1" as="geometry"><mxPoint y="-8" as="offset"/><Array as="points"><mxPoint x="1640" y="1530"/><mxPoint x="1640" y="868"/></Array></mxGeometry></mxCell>
        <mxCell id="n276" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;fontSize=10;fontStyle=1;html=1;endArrow=ERzeroToMany;startArrow=ERmandOne;endFill=0;startFill=0;endSize=9;startSize=9;rounded=0;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n53" target="n91"><mxGeometry x="0.75" relative="1" as="geometry"><mxPoint y="-8" as="offset"/><Array as="points"><mxPoint x="469" y="1558"/><mxPoint x="469" y="534"/></Array></mxGeometry></mxCell>
        <mxCell id="n277" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;fontSize=10;fontStyle=1;html=1;endArrow=ERzeroToMany;startArrow=ERmandOne;endFill=0;startFill=0;endSize=9;startSize=9;rounded=0;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n60" target="n147"><mxGeometry x="0.75" relative="1" as="geometry"><mxPoint y="-8" as="offset"/><Array as="points"><mxPoint x="482" y="1772"/><mxPoint x="482" y="372"/><mxPoint x="1152" y="372"/><mxPoint x="1152" y="1412"/></Array></mxGeometry></mxCell>
        <mxCell id="n278" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;fontSize=10;fontStyle=1;html=1;endArrow=ERzeroToMany;startArrow=ERmandOne;endFill=0;startFill=0;endSize=9;startSize=9;rounded=0;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n69" target="n152"><mxGeometry x="0.75" relative="1" as="geometry"><mxPoint y="-8" as="offset"/><Array as="points"><mxPoint x="495" y="2034"/><mxPoint x="495" y="385"/><mxPoint x="1165" y="385"/><mxPoint x="1165" y="1578"/></Array></mxGeometry></mxCell>
        <mxCell id="n279" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;fontSize=10;fontStyle=1;html=1;endArrow=ERzeroToMany;startArrow=ERmandOne;endFill=0;startFill=0;endSize=9;startSize=9;rounded=0;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n78" target="n105"><mxGeometry x="0.75" relative="1" as="geometry"><mxPoint y="-8" as="offset"/><Array as="points"><mxPoint x="508" y="2296"/><mxPoint x="508" y="916"/></Array></mxGeometry></mxCell>
        <mxCell id="n280" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;fontSize=10;fontStyle=1;html=1;endArrow=ERzeroToMany;startArrow=ERmandOne;endFill=0;startFill=0;endSize=9;startSize=9;rounded=0;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n84" target="n104"><mxGeometry x="0.75" relative="1" as="geometry"><mxPoint y="-8" as="offset"/><Array as="points"><mxPoint x="521" y="2486"/><mxPoint x="521" y="892"/></Array></mxGeometry></mxCell>
        <mxCell id="n281" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;fontSize=10;fontStyle=1;html=1;endArrow=ERzeroToMany;startArrow=ERmandOne;endFill=0;startFill=0;endSize=9;startSize=9;rounded=0;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n84" target="n108"><mxGeometry x="0.75" relative="1" as="geometry"><mxPoint y="-8" as="offset"/><Array as="points"><mxPoint x="534" y="2486"/><mxPoint x="534" y="1034"/></Array></mxGeometry></mxCell>
        <mxCell id="n282" value="&lt;b&gt;How to read it&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;background:#D5E8D4&quot;&gt;&amp;nbsp;1 - green&amp;nbsp;&lt;/span&gt; starts here: needs no other table (create these first)&lt;br&gt;&lt;span style=&quot;background:#E1D5E7&quot;&gt;&amp;nbsp;2, 3 … - purple&amp;nbsp;&lt;/span&gt; uses other tables; the number = the order you create them&lt;br&gt;&lt;span style=&quot;background:#F5F5F5&quot;&gt;&amp;nbsp;grey&amp;nbsp;&lt;/span&gt; a table from another module (only its key columns)&lt;br&gt;&lt;span style=&quot;background:#E3EEFA&quot;&gt;&amp;nbsp;blue row&amp;nbsp;&lt;/span&gt; stored on purpose: a fact of that moment&lt;br&gt;&lt;b&gt;bold&lt;/b&gt; = PK (primary key) · &lt;i&gt;italic&lt;/i&gt; = FK (points to another table)&lt;br&gt;Line ends: &lt;b&gt;|&lt;/b&gt; one · &lt;b&gt;o&lt;/b&gt; optional (zero) · &lt;b&gt;crow’s foot&lt;/b&gt; many" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;fontSize=12;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#8C7A76;" vertex="1" parent="1"><mxGeometry x="3036" y="20" width="500" height="150" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="nf-2" name="Normalization (1NF to 3NF)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1900" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="n283" value="&lt;b style=&quot;font-size:24px&quot;&gt;Normalization: removing redundancy (1NF → 2NF → 3NF)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Redundancy = the same fact stored in more than one place. The copies can disagree, so each fact must live in exactly one table; other tables point to it with a foreign key.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1700" height="70" as="geometry"/></mxCell>
        <mxCell id="n284" value="&lt;b style=&quot;font-size:14px&quot;&gt;Why redundancy is a problem (update anomaly)&lt;/b&gt;&lt;br&gt;Before: &lt;i&gt;orders.total_usd&lt;/i&gt; = $27 is stored, and the same total is also the SUM of its &lt;i&gt;order_items&lt;/i&gt;. If an item changes but the total is not updated (a bug, a crash, a manual edit), the two disagree — which one is true?&lt;br&gt;After: only the items are stored. The total is &lt;b&gt;calculated&lt;/b&gt; when needed, so it can never be wrong." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;fontSize=12;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#8C7A76;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="820" height="110" as="geometry"/></mxCell>
        <mxCell id="n285" value="&lt;b style=&quot;font-size:14px&quot;&gt;The three rules&lt;/b&gt;&lt;br&gt;&lt;b&gt;1NF&lt;/b&gt; — one value per cell: no lists, no “several things in one column”.&lt;br&gt;&lt;b&gt;2NF&lt;/b&gt; — every column depends on the &lt;b&gt;whole&lt;/b&gt; key (matters for tables whose key is two columns).&lt;br&gt;&lt;b&gt;3NF&lt;/b&gt; — no column depends on another non-key column: &lt;b&gt;nothing that can be calculated or looked up&lt;/b&gt; is stored.&lt;br&gt;Rule of thumb: &lt;i&gt;“the key, the whole key, and nothing but the key.”&lt;/i&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;fontSize=12;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#8C7A76;" vertex="1" parent="1"><mxGeometry x="880" y="110" width="840" height="110" as="geometry"/></mxCell>
        <mxCell id="n286" value="&lt;b style=&quot;font-size:14px&quot;&gt;1NF fix&lt;/b&gt;&lt;br&gt;&lt;b&gt;product_details.specifications&lt;/b&gt; held a list in one cell (Material: …, Size: …, Pack: …), and &lt;b&gt;material&lt;/b&gt;, &lt;b&gt;color&lt;/b&gt; repeated two of those facts in their own columns.&lt;br&gt;→ new table &lt;b&gt;product_specifications&lt;/b&gt;: one row per fact (product_id, name, value). material and color become rows, so they are stored once.&lt;br&gt;&lt;br&gt;Already 1NF earlier: gallery → product_images; location → latitude + longitude." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;fontSize=12;fontColor=#000000;fillColor=#E1F3E9;strokeColor=#1E7A4C;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="560" height="175" as="geometry"/></mxCell>
        <mxCell id="n287" value="&lt;b style=&quot;font-size:14px&quot;&gt;2NF fix&lt;/b&gt;&lt;br&gt;&lt;b&gt;order_items&lt;/b&gt; (key: order + product) stored &lt;b&gt;product_title&lt;/b&gt; and &lt;b&gt;product_image&lt;/b&gt;. They depend on the product only, not on the order → partial dependency.&lt;br&gt;→ removed. The name and photo come from &lt;i&gt;products&lt;/i&gt; through product_id. Products are never deleted (status = archived), so old orders always find them.&lt;br&gt;&lt;br&gt;Also: &lt;b&gt;UNIQUE (order_id, product_id)&lt;/b&gt; so one product appears once per order (quantity says how many)." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;fontSize=12;fontColor=#000000;fillColor=#E1F3E9;strokeColor=#1E7A4C;" vertex="1" parent="1"><mxGeometry x="620" y="240" width="520" height="175" as="geometry"/></mxCell>
        <mxCell id="n288" value="&lt;b style=&quot;font-size:14px&quot;&gt;3NF fixes: calculated values removed&lt;/b&gt;&lt;br&gt;• customers.&lt;b&gt;loyalty_tier_id&lt;/b&gt; = the tier their delivered orders reach (Plus / Pro / Max)&lt;br&gt;• customers.&lt;b&gt;total_spent_usd&lt;/b&gt; = SUM of delivered order totals&lt;br&gt;• orders.&lt;b&gt;discount_usd&lt;/b&gt; = the promo code’s discount on the items&lt;br&gt;• product_stocks.&lt;b&gt;quantity_on_hand&lt;/b&gt; = SUM(stock_movements.quantity_change)&lt;br&gt;• product_stocks.&lt;b&gt;average_cost_usd&lt;/b&gt; = from purchase_order_items&lt;br&gt;• orders.&lt;b&gt;subtotal_usd&lt;/b&gt; / &lt;b&gt;total_usd&lt;/b&gt; = from order_items + fees&lt;br&gt;• purchase_orders.&lt;b&gt;total_cost_usd&lt;/b&gt; = from purchase_order_items" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;fontSize=12;fontColor=#000000;fillColor=#E1F3E9;strokeColor=#1E7A4C;" vertex="1" parent="1"><mxGeometry x="1160" y="240" width="560" height="175" as="geometry"/></mxCell>
        <mxCell id="n289" value="&lt;b style=&quot;font-size:14px&quot;&gt;3NF fixes: facts stored twice removed&lt;/b&gt;&lt;br&gt;• orders.&lt;b&gt;order_status_id&lt;/b&gt; — the current status is the newest row of order_status_history&lt;br&gt;• orders.&lt;b&gt;payment_method_id&lt;/b&gt; — the method is on each payments row&lt;br&gt;• orders.&lt;b&gt;handled_by&lt;/b&gt; — who approved it is order_status_history.changed_by&lt;br&gt;• &lt;b&gt;user_notifications&lt;/b&gt; (whole table) — the bell is built from orders, status history, payments and messages&lt;br&gt;• orders.&lt;b&gt;customer_name, customer_phone, delivery_address, latitude, longitude&lt;/b&gt; — they are the address the order points to (address_id)&lt;br&gt;• stock_movements.&lt;b&gt;unit_cost_usd, unit_price_usd&lt;/b&gt; — already on purchase_order_items / order_items&lt;br&gt;• &lt;b&gt;user_settings&lt;/b&gt; (whole table) — theme, language and notifications stay in the browser, so the database doesn’t need them" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;fontSize=12;fontColor=#000000;fillColor=#E1F3E9;strokeColor=#1E7A4C;" vertex="1" parent="1"><mxGeometry x="40" y="435" width="860" height="170" as="geometry"/></mxCell>
        <mxCell id="n290" value="&lt;b style=&quot;font-size:14px&quot;&gt;Stored on purpose (blue rows) — facts of that moment, not copies&lt;/b&gt;&lt;br&gt;• order_items.&lt;b&gt;unit_price_usd&lt;/b&gt;: the price agreed in that sale. products.price_usd is today’s price and will change; the old sale must not.&lt;br&gt;• order_items.&lt;b&gt;unit_cost_usd&lt;/b&gt;, purchase_order_items.&lt;b&gt;unit_cost_usd&lt;/b&gt;: what the item cost at that time (for profit).&lt;br&gt;• orders.&lt;b&gt;delivery_fee_usd, member_discount_usd&lt;/b&gt;: the rules (free delivery, the customer’s tier that day) change over time.&lt;br&gt;• payments.&lt;b&gt;amount_usd&lt;/b&gt;: what was actually paid in that attempt.&lt;br&gt;These cannot be calculated later, so storing them is &lt;b&gt;not&lt;/b&gt; redundancy." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;fontSize=12;fontColor=#000000;fillColor=#E3EEFA;strokeColor=#2563A8;" vertex="1" parent="1"><mxGeometry x="920" y="435" width="800" height="170" as="geometry"/></mxCell>
        <mxCell id="n291" value="&lt;b style=&quot;font-size:14px&quot;&gt;Tables changed&lt;/b&gt;&lt;br&gt;• &lt;b&gt;product_stocks removed&lt;/b&gt;: after taking out the calculated columns only low_stock_threshold was left, so it moves to &lt;i&gt;products&lt;/i&gt; (one table less).&lt;br&gt;• &lt;b&gt;product_specifications added&lt;/b&gt; (1NF).&lt;br&gt;• &lt;b&gt;showcase_products removed&lt;/b&gt;: a product’s place in the showcase is one column, products.showcase_position.&lt;br&gt;• &lt;b&gt;loyalty_transactions removed&lt;/b&gt;: points could not be spent; membership comes from spending.&lt;br&gt;• &lt;b&gt;promo_codes added&lt;/b&gt;; orders point at the code they used.&lt;br&gt;• &lt;b&gt;customer_addresses.archived_at&lt;/b&gt;: an address used by an order is never edited, so every order keeps the address it was really sent to.&lt;br&gt;• loyalty_tiers is a lookup table (spend ≥ min_spend_usd), no foreign key." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;fontSize=12;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#8C7A76;" vertex="1" parent="1"><mxGeometry x="40" y="625" width="860" height="160" as="geometry"/></mxCell>
        <mxCell id="n292" value="&lt;b style=&quot;font-size:14px&quot;&gt;Result&lt;/b&gt;&lt;br&gt;&lt;b&gt;28 tables&lt;/b&gt; (−product_stocks, −user_settings, −user_notifications, −showcase_products, −loyalty_transactions, +product_specifications, +promo_codes).&lt;br&gt;Every removed column was either calculated or a second copy of a fact.&lt;br&gt;Every table is in &lt;b&gt;3NF&lt;/b&gt;: each non-key column describes only its own row’s key.&lt;br&gt;The website looks the same: totals, tier, discounts, stock and the bell are calculated when a page needs them." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;fontSize=12;fontColor=#000000;fillColor=#E1F3E9;strokeColor=#1E7A4C;" vertex="1" parent="1"><mxGeometry x="920" y="625" width="800" height="160" as="geometry"/></mxCell>
        <mxCell id="n293" value="&lt;b&gt;How to read it&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;background:#D5E8D4&quot;&gt;&amp;nbsp;1 - green&amp;nbsp;&lt;/span&gt; starts here: needs no other table (create these first)&lt;br&gt;&lt;span style=&quot;background:#E1D5E7&quot;&gt;&amp;nbsp;2, 3 … - purple&amp;nbsp;&lt;/span&gt; uses other tables; the number = the order you create them&lt;br&gt;&lt;span style=&quot;background:#F5F5F5&quot;&gt;&amp;nbsp;grey&amp;nbsp;&lt;/span&gt; a table from another module (only its key columns)&lt;br&gt;&lt;span style=&quot;background:#E3EEFA&quot;&gt;&amp;nbsp;blue row&amp;nbsp;&lt;/span&gt; stored on purpose: a fact of that moment&lt;br&gt;&lt;b&gt;bold&lt;/b&gt; = PK (primary key) · &lt;i&gt;italic&lt;/i&gt; = FK (points to another table)&lt;br&gt;Line ends: &lt;b&gt;|&lt;/b&gt; one · &lt;b&gt;o&lt;/b&gt; optional (zero) · &lt;b&gt;crow’s foot&lt;/b&gt; many" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;fontSize=12;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#8C7A76;" vertex="1" parent="1"><mxGeometry x="1250" y="805" width="500" height="150" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="nf-3" name="Calculated, not stored">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1900" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="n294" value="&lt;b style=&quot;font-size:24px&quot;&gt;Calculated, not stored&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Every value that was removed for 3NF, and exactly how the system works it out. These are what the website shows; they are never saved in a column.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1700" height="70" as="geometry"/></mxCell>
        <mxCell id="n295" value="&lt;b style=&quot;font-size:14px&quot;&gt;Customer’s tier (Plus / Pro / Max)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace&quot;&gt;the loyalty_tiers row with the highest min_spend_usd ≤ delivered spending since the last 18-day gap without an order&lt;/span&gt;&lt;br&gt;&lt;i&gt;from: orders, order_status_history, loyalty_tiers&lt;/i&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;fontSize=12;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#8C7A76;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="840" height="92" as="geometry"/></mxCell>
        <mxCell id="n296" value="&lt;b style=&quot;font-size:14px&quot;&gt;Customer’s total spent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace&quot;&gt;SUM(order total) of the customer’s delivered orders&lt;/span&gt;&lt;br&gt;&lt;i&gt;from: orders, order_items, order_status_history&lt;/i&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;fontSize=12;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#8C7A76;" vertex="1" parent="1"><mxGeometry x="900" y="110" width="840" height="92" as="geometry"/></mxCell>
        <mxCell id="n297" value="&lt;b style=&quot;font-size:14px&quot;&gt;Stock on hand&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace&quot;&gt;SUM(quantity_change) FROM stock_movements WHERE product_id = ?&lt;/span&gt;&lt;br&gt;&lt;i&gt;from: stock_movements&lt;/i&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;fontSize=12;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#8C7A76;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="840" height="92" as="geometry"/></mxCell>
        <mxCell id="n298" value="&lt;b style=&quot;font-size:14px&quot;&gt;Average buy cost&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace&quot;&gt;SUM(quantity × unit_cost_usd) ÷ SUM(quantity) over received purchase_order_items&lt;/span&gt;&lt;br&gt;&lt;i&gt;from: purchase_order_items&lt;/i&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;fontSize=12;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#8C7A76;" vertex="1" parent="1"><mxGeometry x="900" y="220" width="840" height="92" as="geometry"/></mxCell>
        <mxCell id="n299" value="&lt;b style=&quot;font-size:14px&quot;&gt;Order subtotal&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace&quot;&gt;SUM(quantity × unit_price_usd) FROM order_items WHERE order_id = ?&lt;/span&gt;&lt;br&gt;&lt;i&gt;from: order_items&lt;/i&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;fontSize=12;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#8C7A76;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="840" height="92" as="geometry"/></mxCell>
        <mxCell id="n300" value="&lt;b style=&quot;font-size:14px&quot;&gt;Promo discount&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace&quot;&gt;the code’s percent (or $) of (subtotal − member_discount_usd)&lt;/span&gt;&lt;br&gt;&lt;i&gt;from: promo_codes + order_items&lt;/i&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;fontSize=12;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#8C7A76;" vertex="1" parent="1"><mxGeometry x="900" y="330" width="840" height="92" as="geometry"/></mxCell>
        <mxCell id="n301" value="&lt;b style=&quot;font-size:14px&quot;&gt;Order total&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace&quot;&gt;subtotal − member_discount_usd − promo discount + delivery_fee_usd&lt;/span&gt;&lt;br&gt;&lt;i&gt;from: orders + subtotal&lt;/i&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;fontSize=12;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#8C7A76;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="840" height="92" as="geometry"/></mxCell>
        <mxCell id="n302" value="&lt;b style=&quot;font-size:14px&quot;&gt;Selling price (sale)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace&quot;&gt;price_usd × (100 − discount_percent) ÷ 100 while discount_ends_at has not passed&lt;/span&gt;&lt;br&gt;&lt;i&gt;from: products&lt;/i&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;fontSize=12;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#8C7A76;" vertex="1" parent="1"><mxGeometry x="900" y="440" width="840" height="92" as="geometry"/></mxCell>
        <mxCell id="n303" value="&lt;b style=&quot;font-size:14px&quot;&gt;Current order status&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace&quot;&gt;the newest order_status_history row of the order&lt;/span&gt;&lt;br&gt;&lt;i&gt;from: order_status_history&lt;/i&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;fontSize=12;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#8C7A76;" vertex="1" parent="1"><mxGeometry x="40" y="550" width="840" height="92" as="geometry"/></mxCell>
        <mxCell id="n304" value="&lt;b style=&quot;font-size:14px&quot;&gt;Who handles the order&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace&quot;&gt;changed_by of the history row that moved it to “processing”&lt;/span&gt;&lt;br&gt;&lt;i&gt;from: order_status_history&lt;/i&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;fontSize=12;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#8C7A76;" vertex="1" parent="1"><mxGeometry x="900" y="550" width="840" height="92" as="geometry"/></mxCell>
        <mxCell id="n305" value="&lt;b style=&quot;font-size:14px&quot;&gt;Payment method / status&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace&quot;&gt;the newest payments row of the order&lt;/span&gt;&lt;br&gt;&lt;i&gt;from: payments&lt;/i&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;fontSize=12;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#8C7A76;" vertex="1" parent="1"><mxGeometry x="40" y="660" width="840" height="92" as="geometry"/></mxCell>
        <mxCell id="n306" value="&lt;b style=&quot;font-size:14px&quot;&gt;Purchase order total&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace&quot;&gt;SUM(quantity × unit_cost_usd) FROM purchase_order_items&lt;/span&gt;&lt;br&gt;&lt;i&gt;from: purchase_order_items&lt;/i&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;fontSize=12;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#8C7A76;" vertex="1" parent="1"><mxGeometry x="900" y="660" width="840" height="92" as="geometry"/></mxCell>
        <mxCell id="n307" value="&lt;b style=&quot;font-size:14px&quot;&gt;Product rating&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace&quot;&gt;AVG(rating), COUNT(*) FROM product_reviews WHERE product_id = ?&lt;/span&gt;&lt;br&gt;&lt;i&gt;from: product_reviews&lt;/i&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;fontSize=12;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#8C7A76;" vertex="1" parent="1"><mxGeometry x="40" y="770" width="840" height="92" as="geometry"/></mxCell>
        <mxCell id="n308" value="&lt;b style=&quot;font-size:14px&quot;&gt;Notification bell&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace&quot;&gt;new orders, status changes, sent-back slips and messages of the last 30 days&lt;/span&gt;&lt;br&gt;&lt;i&gt;from: orders, order_status_history, payments, order_messages&lt;/i&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;fontSize=12;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#8C7A76;" vertex="1" parent="1"><mxGeometry x="900" y="770" width="840" height="92" as="geometry"/></mxCell>
        <mxCell id="n309" value="&lt;b style=&quot;font-size:14px&quot;&gt;Price in riel&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace&quot;&gt;USD × 4,000 (shown only; money is stored in USD)&lt;/span&gt;&lt;br&gt;&lt;i&gt;from: any USD amount&lt;/i&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;fontSize=12;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#8C7A76;" vertex="1" parent="1"><mxGeometry x="40" y="880" width="840" height="92" as="geometry"/></mxCell>
        <mxCell id="n310" value="&lt;b&gt;Speed&lt;/b&gt;: at PsaOnline’s size these sums take milliseconds. If one ever gets slow, create a database &lt;b&gt;VIEW&lt;/b&gt; (for example &lt;i&gt;order_totals&lt;/i&gt;) — a saved query, not a table — so the numbers still can’t go out of date." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;fontSize=12;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#8C7A76;" vertex="1" parent="1"><mxGeometry x="40" y="1000" width="1700" height="80" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="nf-4" name="Main Module">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1900" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="n311" value="&lt;b style=&quot;font-size:24px&quot;&gt;PsaOnline: Main Module&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Big modules and the small modules inside them; each has a schema page in this file.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1700" height="70" as="geometry"/></mxCell>
        <mxCell id="n312" value="PsaOnline" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;fontSize=12;fontColor=#000000;align=center;verticalAlign=middle;spacingTop=0;fontStyle=1;fillColor=#FFFFFF;strokeColor=#2B1D1D;" vertex="1" parent="1"><mxGeometry x="900" y="100" width="180" height="56" as="geometry"/></mxCell>
        <mxCell id="n313" value="Website (shoppers)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;fontSize=12;fontColor=#000000;align=center;verticalAlign=middle;spacingTop=0;fontStyle=1;fillColor=#FFFFFF;strokeColor=#2B1D1D;" vertex="1" parent="1"><mxGeometry x="390" y="210" width="190" height="50" as="geometry"/></mxCell>
        <mxCell id="n314" value="Dashboard (staff portal)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;fontSize=12;fontColor=#000000;align=center;verticalAlign=middle;spacingTop=0;fontStyle=1;fillColor=#FFFFFF;strokeColor=#2B1D1D;" vertex="1" parent="1"><mxGeometry x="1390" y="210" width="200" height="50" as="geometry"/></mxCell>
        <mxCell id="n315" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n312" target="n313"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n316" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n312" target="n314"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n317" value="Customer" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;fontSize=12;fontColor=#000000;align=center;verticalAlign=middle;spacingTop=0;fillColor=#FFFFFF;strokeColor=#2B1D1D;" vertex="1" parent="1"><mxGeometry x="410" y="310" width="150" height="50" as="geometry"/></mxCell>
        <mxCell id="n318" value="Admin / Staff" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;fontSize=12;fontColor=#000000;align=center;verticalAlign=middle;spacingTop=0;fillColor=#FFFFFF;strokeColor=#2B1D1D;" vertex="1" parent="1"><mxGeometry x="1415" y="310" width="150" height="50" as="geometry"/></mxCell>
        <mxCell id="n319" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n313" target="n317"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n320" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n314" target="n318"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n321" value="Account &amp; Addresses" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;fontSize=12;fontColor=#000000;align=center;verticalAlign=middle;spacingTop=0;fillColor=#FFFFFF;strokeColor=#2B1D1D;" vertex="1" parent="1"><mxGeometry x="20" y="430" width="110" height="80" as="geometry"/></mxCell>
        <mxCell id="n322" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n317" target="n321"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n323" value="Shop &amp; Cart" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;fontSize=12;fontColor=#000000;align=center;verticalAlign=middle;spacingTop=0;fillColor=#FFFFFF;strokeColor=#2B1D1D;" vertex="1" parent="1"><mxGeometry x="138" y="430" width="110" height="80" as="geometry"/></mxCell>
        <mxCell id="n324" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n317" target="n323"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n325" value="Checkout (order)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;fontSize=12;fontColor=#000000;align=center;verticalAlign=middle;spacingTop=0;fillColor=#FFFFFF;strokeColor=#2B1D1D;" vertex="1" parent="1"><mxGeometry x="256" y="430" width="110" height="80" as="geometry"/></mxCell>
        <mxCell id="n326" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n317" target="n325"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n327" value="Payment" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;fontSize=12;fontColor=#000000;align=center;verticalAlign=middle;spacingTop=0;fillColor=#FFFFFF;strokeColor=#2B1D1D;" vertex="1" parent="1"><mxGeometry x="374" y="430" width="110" height="80" as="geometry"/></mxCell>
        <mxCell id="n328" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n317" target="n327"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n329" value="Order Tracking &amp; Receipt" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;fontSize=12;fontColor=#000000;align=center;verticalAlign=middle;spacingTop=0;fillColor=#FFFFFF;strokeColor=#2B1D1D;" vertex="1" parent="1"><mxGeometry x="492" y="430" width="110" height="80" as="geometry"/></mxCell>
        <mxCell id="n330" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n317" target="n329"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n331" value="Reviews" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;fontSize=12;fontColor=#000000;align=center;verticalAlign=middle;spacingTop=0;fillColor=#FFFFFF;strokeColor=#2B1D1D;" vertex="1" parent="1"><mxGeometry x="610" y="430" width="110" height="80" as="geometry"/></mxCell>
        <mxCell id="n332" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n317" target="n331"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n333" value="Membership &amp; Promo codes" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;fontSize=12;fontColor=#000000;align=center;verticalAlign=middle;spacingTop=0;fillColor=#FFFFFF;strokeColor=#2B1D1D;" vertex="1" parent="1"><mxGeometry x="728" y="430" width="110" height="80" as="geometry"/></mxCell>
