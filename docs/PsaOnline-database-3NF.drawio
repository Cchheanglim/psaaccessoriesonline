        <mxCell id="n513" value="&lt;b&gt;Relationships&lt;/b&gt;&lt;br&gt;• categories 1 : N products · categories 1 : N categories (parent_id: sub-categories)&lt;br&gt;• products 1 : 1 product_details&lt;br&gt;• products 1 : N product_specifications, product_images, product_reviews&lt;br&gt;• orders 1 : N product_reviews · customers 1 : N product_reviews&lt;br&gt;• UNIQUE (order_id, product_id): one review per bought item" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;fontSize=12;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#8C7A76;" vertex="1" parent="1"><mxGeometry x="1540" y="420" width="430" height="220" as="geometry"/></mxCell>
        <mxCell id="n514" value="&lt;b&gt;How to read it&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;background:#D5E8D4&quot;&gt;&amp;nbsp;1 - green&amp;nbsp;&lt;/span&gt; starts here: needs no other table (create these first)&lt;br&gt;&lt;span style=&quot;background:#E1D5E7&quot;&gt;&amp;nbsp;2, 3 … - purple&amp;nbsp;&lt;/span&gt; uses other tables; the number = the order you create them&lt;br&gt;&lt;span style=&quot;background:#F5F5F5&quot;&gt;&amp;nbsp;grey&amp;nbsp;&lt;/span&gt; a table from another module (only its key columns)&lt;br&gt;&lt;span style=&quot;background:#E3EEFA&quot;&gt;&amp;nbsp;blue row&amp;nbsp;&lt;/span&gt; stored on purpose: a fact of that moment&lt;br&gt;&lt;b&gt;bold&lt;/b&gt; = PK (primary key) · &lt;i&gt;italic&lt;/i&gt; = FK (points to another table)&lt;br&gt;Line ends: &lt;b&gt;|&lt;/b&gt; one · &lt;b&gt;o&lt;/b&gt; optional (zero) · &lt;b&gt;crow’s foot&lt;/b&gt; many" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;fontSize=12;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#8C7A76;" vertex="1" parent="1"><mxGeometry x="40" y="734" width="500" height="150" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="nf-8" name="Stock &amp; Suppliers">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1900" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="n515" value="&lt;b style=&quot;font-size:24px&quot;&gt;Stock &amp;amp; Suppliers (buy price / sell price)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;What you BUY comes in through purchase orders; what you SELL goes out through order items. Every stock change is a row in stock_movements; stock on hand is their sum.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1700" height="70" as="geometry"/></mxCell>
