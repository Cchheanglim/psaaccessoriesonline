        <mxCell id="n393" value="&lt;b style=&quot;font-size:24px&quot;&gt;Customers, Membership &amp;amp; Promo codes&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;The tier is not stored: it is worked out from the customer’s delivered orders. Promo codes are typed at checkout; the order remembers which one it used.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1700" height="70" as="geometry"/></mxCell>
