        <mxCell id="n693" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=ERzeroToMany;startArrow=ERmandOne;endFill=0;startFill=0;endSize=9;startSize=9;fontSize=11;fontStyle=1;labelBackgroundColor=default;exitX=1;exitY=0.500;exitDx=0;exitDy=0;entryX=0;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="n653" target="n654"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="286" y="993"/><mxPoint x="286" y="993"/></Array></mxGeometry></mxCell>
        <mxCell id="n694" value="&lt;b&gt;Many-to-many&lt;/b&gt;: orders ⟷ products (order_items), purchase_orders ⟷ products (purchase_order_items), sort_options ⟷ products (sort_option_products). &lt;b&gt;Self-link&lt;/b&gt;: categories.parent_id. &lt;b&gt;Settings&lt;/b&gt;: site_settings (key → value, no FK). Everything else is one-to-many." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;fontSize=12;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#8C7A76;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="1100" height="70" as="geometry"/></mxCell>
        <mxCell id="n695" value="&lt;b&gt;How to read it&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;background:#D5E8D4&quot;&gt;&amp;nbsp;1 - green&amp;nbsp;&lt;/span&gt; starts here: needs no other table (create these first)&lt;br&gt;&lt;span style=&quot;background:#E1D5E7&quot;&gt;&amp;nbsp;2, 3 … - purple&amp;nbsp;&lt;/span&gt; uses other tables; the number = the order you create them&lt;br&gt;&lt;span style=&quot;background:#F5F5F5&quot;&gt;&amp;nbsp;grey&amp;nbsp;&lt;/span&gt; a table from another module (only its key columns)&lt;br&gt;&lt;span style=&quot;background:#E3EEFA&quot;&gt;&amp;nbsp;blue row&amp;nbsp;&lt;/span&gt; stored on purpose: a fact of that moment&lt;br&gt;&lt;b&gt;bold&lt;/b&gt; = PK (primary key) · &lt;i&gt;italic&lt;/i&gt; = FK (points to another table)&lt;br&gt;Line ends: &lt;b&gt;|&lt;/b&gt; one · &lt;b&gt;o&lt;/b&gt; optional (zero) · &lt;b&gt;crow’s foot&lt;/b&gt; many" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;fontSize=12;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#8C7A76;" vertex="1" parent="1"><mxGeometry x="1260" y="96" width="500" height="150" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="nf-13" name="Website settings (site_settings)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1900" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="n696" value="&lt;b style=&quot;font-size:24px&quot;&gt;site_settings: the website text staff edit&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;One row = one piece of text (or one shop rule) shown on the website. Staff change them on the staff portal’s Website page; the shop reads them on every page.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1700" height="70" as="geometry"/></mxCell>
        <mxCell id="n697" value="1 - site_settings" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fontSize=13;fontColor=#000000;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="260" height="102" as="geometry"/></mxCell>
        <mxCell id="n698" value="setting_key : varchar (PK)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=12;fontStyle=1;" vertex="1" parent="n697"><mxGeometry y="30" width="260" height="24" as="geometry"/></mxCell>
        <mxCell id="n699" value="setting_value : text" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=12;" vertex="1" parent="n697"><mxGeometry y="54" width="260" height="24" as="geometry"/></mxCell>
        <mxCell id="n700" value="updated_at : timestamp" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=12;" vertex="1" parent="n697"><mxGeometry y="78" width="260" height="24" as="geometry"/></mxCell>
        <mxCell id="n701" value="&lt;span style=&quot;font-size:12px&quot;&gt;One row = one piece of text shown on the website. Saving the same key again updates its row.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="260" height="60" as="geometry"/></mxCell>
        <mxCell id="n702" value="Rows saved in site_settings (46)" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fontSize=13;fontColor=#000000;fillColor=#F5F0EA;strokeColor=#8C7A76;" vertex="1" parent="1"><mxGeometry x="360" y="120" width="640" height="1158" as="geometry"/></mxCell>
        <mxCell id="n703" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:12px&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:250px;font-weight:bold;&quot;&gt;setting_key&lt;/td&gt;&lt;td style=&quot;width:330px;font-weight:bold;&quot;&gt;setting_value&lt;/td&gt;&lt;td style=&quot;text-align:center;font-weight:bold;&quot;&gt;&lt;span style=&quot;;padding:1px 5px;border-radius:4px&quot;&gt;used in&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;overflow=hidden;html=1;fontSize=12;" vertex="1" parent="n702"><mxGeometry y="30" width="640" height="24" as="geometry"/></mxCell>
        <mxCell id="n704" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:12px&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:250px;&quot;&gt;site.name&lt;/td&gt;&lt;td style=&quot;width:330px;&quot;&gt;PsaOnline&lt;/td&gt;&lt;td style=&quot;text-align:center;&quot;&gt;&lt;span style=&quot;background:#E1F3E9;padding:1px 5px;border-radius:4px&quot;&gt;H&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;overflow=hidden;html=1;fontSize=12;" vertex="1" parent="n702"><mxGeometry y="54" width="640" height="24" as="geometry"/></mxCell>
        <mxCell id="n705" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:12px&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:250px;&quot;&gt;site.tagline&lt;/td&gt;&lt;td style=&quot;width:330px;&quot;&gt;Gifts &amp;amp; cute finds&lt;/td&gt;&lt;td style=&quot;text-align:center;&quot;&gt;&lt;span style=&quot;background:#E1F3E9;padding:1px 5px;border-radius:4px&quot;&gt;H&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;overflow=hidden;html=1;fontSize=12;" vertex="1" parent="n702"><mxGeometry y="78" width="640" height="24" as="geometry"/></mxCell>
