        <mxCell id="1" parent="0"/>
        <mxCell id="n613" value="&lt;b style=&quot;font-size:24px&quot;&gt;Shop content (staff-managed)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;The home showcase, the shop’s Sort By menu (with free-delivery groups) and shop-wide text such as the headline and social accounts.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1700" height="70" as="geometry"/></mxCell>
        <mxCell id="n614" value="products (Product module)" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fontSize=13;fillColor=#F5F5F5;fontColor=#333333;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="370" height="126" as="geometry"/></mxCell>
