        <mxCell id="n345" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;fontSize=11;fontStyle=1;html=1;endArrow=ERzeroToMany;startArrow=ERmandOne;endFill=0;startFill=0;endSize=10;startSize=10;rounded=0;labelBackgroundColor=default;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n328" target="n325"><mxGeometry x="0.7" relative="1" as="geometry"><mxPoint y="-9" as="offset"/><Array as="points"><mxPoint x="434" y="182"/><mxPoint x="434" y="182"/></Array></mxGeometry></mxCell>
        <mxCell id="n346" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;fontSize=11;fontStyle=1;html=1;endArrow=ERzeroToMany;startArrow=ERmandOne;endFill=0;startFill=0;endSize=10;startSize=10;rounded=0;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n328" target="n335"><mxGeometry x="0.7" relative="1" as="geometry"><mxPoint y="-9" as="offset"/><Array as="points"><mxPoint x="934" y="182"/><mxPoint x="934" y="206"/></Array></mxGeometry></mxCell>
        <mxCell id="n347" value="&lt;b&gt;Relationships&lt;/b&gt;&lt;br&gt;• roles 1 : N role_permissions: each row = one permission ticked for a role (role_id + permission name, so a role cannot get the same one twice)&lt;br&gt;• roles 1 : N users&lt;br&gt;The 12 permission names are fixed by the website, so they are a list in the code, not a table. A customer IS a user (role buyer): no separate customers table." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;fontSize=12;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#8C7A76;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="870" height="140" as="geometry"/></mxCell>
        <mxCell id="n348" value="&lt;b&gt;How to read it&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;background:#D5E8D4&quot;&gt;&amp;nbsp;1 - green&amp;nbsp;&lt;/span&gt; starts here: needs no other table (create these first)&lt;br&gt;&lt;span style=&quot;background:#E1D5E7&quot;&gt;&amp;nbsp;2, 3 … - purple&amp;nbsp;&lt;/span&gt; uses other tables; the number = the order you create them&lt;br&gt;&lt;span style=&quot;background:#F5F5F5&quot;&gt;&amp;nbsp;grey&amp;nbsp;&lt;/span&gt; a table from another module (only its key columns)&lt;br&gt;&lt;span style=&quot;background:#E3EEFA&quot;&gt;&amp;nbsp;blue row&amp;nbsp;&lt;/span&gt; stored on purpose: a fact of that moment&lt;br&gt;&lt;b&gt;bold&lt;/b&gt; = PK (primary key) · &lt;i&gt;italic&lt;/i&gt; = FK (points to another table)&lt;br&gt;Line ends: &lt;b&gt;|&lt;/b&gt; one · &lt;b&gt;o&lt;/b&gt; optional (zero) · &lt;b&gt;crow’s foot&lt;/b&gt; many" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;fontSize=12;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#8C7A76;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="500" height="150" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="nf-6" name="Customers &amp; Membership">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1900" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="n349" value="&lt;b style=&quot;font-size:24px&quot;&gt;Customers, Membership &amp;amp; Promo codes&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;The tier is not stored: it is worked out from the customer’s delivered orders. Promo codes are typed at checkout; the order remembers which one it used.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1700" height="70" as="geometry"/></mxCell>
