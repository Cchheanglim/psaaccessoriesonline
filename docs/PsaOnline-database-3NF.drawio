        <mxCell id="n597" value="name : varchar" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="n594"><mxGeometry y="78" width="370" height="24" as="geometry"/></mxCell>
        <mxCell id="n598" value="orders (Order module)" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fontSize=13;fillColor=#F5F5F5;fontColor=#333333;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="282" width="370" height="102" as="geometry"/></mxCell>
        <mxCell id="n599" value="id : bigint (PK)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;" vertex="1" parent="n598"><mxGeometry y="30" width="370" height="24" as="geometry"/></mxCell>
        <mxCell id="n600" value="order_number : varchar (UNIQUE)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="n598"><mxGeometry y="54" width="370" height="24" as="geometry"/></mxCell>
        <mxCell id="n601" value="user_id : bigint (FK → users)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=12;fontStyle=2;" vertex="1" parent="n598"><mxGeometry y="78" width="370" height="24" as="geometry"/></mxCell>
        <mxCell id="n602" value="5 - order_messages" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fontSize=13;fillColor=#E1D5E7;fontColor=#000000;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="540" y="140" width="370" height="174" as="geometry"/></mxCell>
        <mxCell id="n603" value="id : bigint (PK)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;" vertex="1" parent="n602"><mxGeometry y="30" width="370" height="24" as="geometry"/></mxCell>
        <mxCell id="n604" value="order_id : bigint (FK → orders)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=12;fontStyle=2;" vertex="1" parent="n602"><mxGeometry y="54" width="370" height="24" as="geometry"/></mxCell>
        <mxCell id="n605" value="sender_id : bigint (FK → users)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=12;fontStyle=2;" vertex="1" parent="n602"><mxGeometry y="78" width="370" height="24" as="geometry"/></mxCell>
        <mxCell id="n606" value="body : text" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="n602"><mxGeometry y="102" width="370" height="24" as="geometry"/></mxCell>
        <mxCell id="n607" value="read_at : timestamp" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="n602"><mxGeometry y="126" width="370" height="24" as="geometry"/></mxCell>
        <mxCell id="n608" value="created_at, updated_at" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="n602"><mxGeometry y="150" width="370" height="24" as="geometry"/></mxCell>
        <mxCell id="n609" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;fontSize=11;fontStyle=1;html=1;endArrow=ERzeroToMany;startArrow=ERmandOne;endFill=0;startFill=0;endSize=10;startSize=10;rounded=0;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n599" target="n604"><mxGeometry x="0.7" relative="1" as="geometry"><mxPoint y="-9" as="offset"/><Array as="points"><mxPoint x="434" y="324"/><mxPoint x="434" y="206"/></Array></mxGeometry></mxCell>
        <mxCell id="n610" value="1 : N sends" style="edgeStyle=orthogonalEdgeStyle;fontSize=11;fontStyle=1;html=1;endArrow=ERzeroToMany;startArrow=ERmandOne;endFill=0;startFill=0;endSize=10;startSize=10;rounded=0;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n595" target="n605"><mxGeometry x="0.7" relative="1" as="geometry"><mxPoint y="-9" as="offset"/><Array as="points"><mxPoint x="454" y="182"/><mxPoint x="454" y="230"/></Array></mxGeometry></mxCell>
        <mxCell id="n611" value="&lt;b&gt;Relationships&lt;/b&gt;&lt;br&gt;• orders 1 : N order_messages · users 1 : N order_messages (sender_id)&lt;br&gt;Whether a message is from staff = is the sender the order’s customer? So no from_staff column (3NF).&lt;br&gt;Customers can delete their own messages; staff can delete any message or the whole chat (rows are removed).&lt;br&gt;&lt;b&gt;The bell&lt;/b&gt;: new orders, status changes, slips sent back and messages of the last 30 days, worked out when the page asks. The browser remembers when the bell was last opened, so nothing is stored for it." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;fontSize=12;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#8C7A76;" vertex="1" parent="1"><mxGeometry x="1040" y="140" width="700" height="170" as="geometry"/></mxCell>
        <mxCell id="n612" value="&lt;b&gt;How to read it&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;background:#D5E8D4&quot;&gt;&amp;nbsp;1 - green&amp;nbsp;&lt;/span&gt; starts here: needs no other table (create these first)&lt;br&gt;&lt;span style=&quot;background:#E1D5E7&quot;&gt;&amp;nbsp;2, 3 … - purple&amp;nbsp;&lt;/span&gt; uses other tables; the number = the order you create them&lt;br&gt;&lt;span style=&quot;background:#F5F5F5&quot;&gt;&amp;nbsp;grey&amp;nbsp;&lt;/span&gt; a table from another module (only its key columns)&lt;br&gt;&lt;span style=&quot;background:#E3EEFA&quot;&gt;&amp;nbsp;blue row&amp;nbsp;&lt;/span&gt; stored on purpose: a fact of that moment&lt;br&gt;&lt;b&gt;bold&lt;/b&gt; = PK (primary key) · &lt;i&gt;italic&lt;/i&gt; = FK (points to another table)&lt;br&gt;Line ends: &lt;b&gt;|&lt;/b&gt; one · &lt;b&gt;o&lt;/b&gt; optional (zero) · &lt;b&gt;crow’s foot&lt;/b&gt; many" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=12;fontSize=12;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#8C7A76;" vertex="1" parent="1"><mxGeometry x="40" y="424" width="500" height="150" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="nf-11" name="Shop content">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1900" pageHeight="1200" math="0" shadow="0">
