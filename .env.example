APP_NAME=PsaOnlineAccessories
APP_ENV=production
# Run `php artisan key:generate` after copying this file. Never commit a real key.
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Phnom_Penh
APP_URL=https://psaonlineaccessories.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# First admin account, created by `php artisan db:seed`. The seeder refuses
# to run in production without a password. Change it after first login.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# stderr sends logs to Render's log viewer instead of a file inside the container.
LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Supabase Postgres. In Supabase click Connect and copy the "Session pooler"
# details. Render cannot reach Supabase's direct host (it is IPv6 only), and
# the transaction pooler on port 6543 does not support the prepared
# statements Laravel uses. Note the username includes your project ref.
DB_CONNECTION=pgsql
DB_HOST=aws-0-your-region.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.your-project-ref
DB_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Comma-separated origins allowed to call /api/*. Leave empty to allow none.
CORS_ALLOWED_ORIGINS=

# Set to the load balancer in front of the app so HTTPS is detected correctly.
# Render terminates TLS at its proxy, so this must be "*" there.
TRUSTED_PROXIES=*

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="support@psaonlineaccessories.com"
MAIL_FROM_NAME="${APP_NAME}"

# Bakong KHQR merchant details, issued by your bank. Not secret, but
# environment-specific, so keep them out of version control.
BAKONG_KHQR_MERCHANT_ID=
BAKONG_KHQR_MERCHANT_NAME=
BAKONG_KHQR_CITY="Phnom Penh"
CURRENCY_EXCHANGE_RATE_USD_KHR=4100

VITE_APP_NAME="${APP_NAME}"
