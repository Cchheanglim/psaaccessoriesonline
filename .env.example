APP_NAME=PsaOnline
APP_ENV=local
# A throwaway key just so the app runs locally out of the box. Production uses its own secret key.
APP_KEY=base64:Nobw6BODrQ8MQ9DzKanXMgiSCnH6HGderPw7QpZHlGI=
APP_DEBUG=true
APP_TIMEZONE=
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Runs out of the box: a ready-made SQLite database with the full catalog and demo accounts is
# included in the repo (database/database.sqlite). Nothing to set up.
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# To use the team's shared Supabase database instead, comment the two lines above, uncomment these,
# and fill in the username/password shared privately (never commit them):
# DB_CONNECTION=pgsql
# DB_HOST=
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=
# DB_PASSWORD=
# DB_SSLMODE=require
# DB_PERSISTENT=true

# Sessions and cache stay on each computer; only shop data lives in Supabase
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="support@psaonline.store"
MAIL_FROM_NAME="${APP_NAME}"

# PsaOnline Cambodia Payment Gateways
BAKONG_KHQR_MERCHANT_ID=
BAKONG_KHQR_MERCHANT_NAME=
BAKONG_KHQR_CITY="Phnom Penh"
CURRENCY_EXCHANGE_RATE_USD_KHR=4000
VITE_APP_NAME="${APP_NAME}"


# Google AI Studio key for the chat assistant (chat.html). Leave empty to use the built-in demo replies.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
